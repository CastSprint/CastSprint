#include <windows.h>

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CastSprint Project"
            VALUE "FileDescription",  "CastSprint Receiver — Free Native Gaming Screen Mirroring"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "castsprint_receiver"
            VALUE "LegalCopyright",   "Copyright (C) 2026 CastSprint Contributors"
            VALUE "OriginalFilename", "castsprint_receiver.exe"
            VALUE "ProductName",      "CastSprint"
            VALUE "ProductVersion",   "0.2.0 Beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
